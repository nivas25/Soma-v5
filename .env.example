# Copy to .env and fill in. Never commit .env.
# Hugging Face read token: https://huggingface.co/settings/tokens
HF_TOKEN=

# Gemini. Read at runtime from the environment. Leave this empty in git.
# Model is gemini-3.8-flash. Do not paste the key into source or commits.
GEMINI_API_KEY=

# Modal (only if you run teacher harvest / LoRA on Modal)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
